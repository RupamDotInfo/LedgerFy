{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LedgerFy",
  "version": "0.1.0",
  "identifier": "info.rupam.ledgerfy",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:5191",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data: asset: http://asset.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "copyright": "LedgerFy",
    "category": "Business",
    "shortDescription": "Offline-first accounting and ERP",
    "longDescription": "LedgerFy is an offline-first desktop accounting and ERP application for Indian businesses."
  }
}
